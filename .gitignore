# Android build settings that belong to one machine, not to the team.
# local.properties holds the absolute SDK path - here A:\Android\Sdk, which
# exists on nobody else's computer.
local.properties

# throwaways
scratch_*

# generated artifacts
graphify-out/
# Blender scenes and generated 3D props. The cabinet is rebuilt from
# build_cabinet.py; parcels come from Hunyuan. Never commit the binary.
*.blend
*.blend[0-9]
scripts/cabinet-sim/props/

