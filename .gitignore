# secrets / local
.env
.env.*
*.pem
*.keystore
*.jks
google-services.json
GoogleService-Info.plist
.claude/settings.local.json
.claude/worktrees/

# The cabinet's own config: its key and its server address. Placed on the
# device at setup, never committed. config.example.js shows the shape and is
# the file that IS committed. See ADR 0004 - one key per cabinet.
src/cabinet/config.js

# Android build settings that belong to one machine, not to the team.
# local.properties holds the absolute SDK path - here A:\Android\Sdk, which
# exists on nobody else's computer.
local.properties

# throwaways
scratch_*

# generated artifacts
graphify-out/
# Blender scenes and generated 3D props. The cabinet is rebuilt from
# build_cabinet.py; parcels come from Hunyuan. Never commit the binary.
*.blend
*.blend[0-9]
scripts/cabinet-sim/props/
# Rendered video. Rebuilt from the shot scripts in film/; the MP4 is output,
# not source, and a few hundred kB of binary per render does not belong here.
scripts/cabinet-sim/film/out/

# caches / build
__pycache__/
*.pyc
node_modules/
dist/
build/
.gradle/
.dart_tool/
Pods/
*.log
.DS_Store
