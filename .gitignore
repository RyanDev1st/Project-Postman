# secrets / local
.env
.env.*
*.pem
*.keystore
*.jks
google-services.json
GoogleService-Info.plist
# A Firebase/GCP service-account key. It signs as the project and can send
# push to every installed app, so it never comes inside this folder. Ryan's
# lives on A:\ and is passed by path, never copied in. These patterns are a
# net under that habit, not a substitute for it.
*-adminsdk-*.json
*service-account*.json
*serviceaccount*.json
firebase-adminsdk*.json
.claude/settings.local.json
.claude/worktrees/

# The cabinet's own config: its key and its server address. Placed on the
# device at setup, never committed. config.example.js shows the shape and is
# the file that IS committed. See ADR 0004 - one key per cabinet.
src/cabinet/config.js

# Every password hash the OTP server holds, and every lockout counter.
# The first file in this project worth stealing. Never committed, never
# copied to a laptop, never left in a backup nobody owns. See ADR 0012.
accounts.db
accounts.db-*
*.db
*.sqlite
*.sqlite3

# Android build settings that belong to one machine, not to the team.
# local.properties holds the absolute SDK path - here A:\Android\Sdk, which
# exists on nobody else's computer.
local.properties

# throwaways
scratch_*

# generated artifacts
graphify-out/
# Blender scenes and generated 3D props. The cabinet is rebuilt from
# build_cabinet.py; parcels come from Hunyuan. Never commit the binary.
*.blend
*.blend[0-9]
scripts/cabinet-sim/props/
# Rendered video. Rebuilt from the shot scripts in film/; the MP4 is output,
# not source, and a few hundred kB of binary per render does not belong here.
scripts/cabinet-sim/film/out/

# caches / build
__pycache__/
*.pyc
node_modules/
dist/
build/
.gradle/
.dart_tool/
Pods/
*.log
.DS_Store

# The server's own data and its development certificate.
#
# data/ holds the SQLite file - real phone numbers, real tokens, and the log
# of who opened what. It is never committed.
#
# config/dev-cert/ holds a PRIVATE KEY. A private key in a repo is a private
# key in every clone. The public locker.crt beside it is the part that gets
# installed on a phone, and it is regenerated with the keystore.
data/
config/dev-cert/

# The hashing key. Deliberately NOT in data/, so a copied database or a
# backup does not carry it. Losing it logs everybody out; leaking it turns
# every six-digit code in the database back into a guessable one. See
# Pepper.kt.
config/pepper.key
