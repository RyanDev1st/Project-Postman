<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug-only additions, merged over src/main/AndroidManifest.xml.

    One line, and it is here rather than in the main manifest so it cannot
    reach a release build: a debug build trusts certificates a person has
    installed on the phone, so it can talk to the development server over real
    HTTPS. See network_security_config.xml for what that does and does not
    allow, and ADR 0020 for why the server has its own certificate at all.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:networkSecurityConfig="@xml/network_security_config"
        tools:replace="android:networkSecurityConfig" />

</manifest>
