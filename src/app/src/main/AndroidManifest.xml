<?xml version="1.0" encoding="utf-8"?>
<!--
    P1-01: the empty app. One screen, a version number, nothing else.

    INTERNET arrives with P1-04, the network layer. It is the only permission
    here: no camera yet - that is asked for on the scan screen, where the need
    is obvious, never on first open - and no notifications yet.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Lets the app tell "no network" apart from "the server is down", so it
        can say which. Neither is a success, but they are different sentences.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartLocker">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SmartLocker">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
