<?xml version="1.0" encoding="utf-8"?>
<!--
    P1-01: the empty app. One screen, a version number, nothing else.

    INTERNET arrives with P1-04, the network layer. It is the only permission
    here: no camera yet - that is asked for on the scan screen, where the need
    is obvious, never on first open - and no notifications yet.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Lets the app tell "no network" apart from "the server is down", so it
        can say which. Neither is a success, but they are different sentences.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        Where you are, so the Home map can show it. COARSE only: the card
        answers "which way to the gate", and a few hundred metres answers it.
        FINE would buy nothing and ask for more, and the walk itself is short
        enough that the difference never shows on a 112dp card.

        Asked for on the Home screen when the map first draws, not on first
        open, and the map works without it - it just has no blue dot.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartLocker">

        <!--
            Substituted from local.properties at build time, so no key is
            ever written in this file. Blank on a clone that has none: the
            SDK then refuses to draw, which is why the app checks
            BuildConfig.MAPS_API_KEY and draws the plan instead.
        -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${mapsApiKey}" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SmartLocker">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
