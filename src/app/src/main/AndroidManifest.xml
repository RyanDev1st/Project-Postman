<?xml version="1.0" encoding="utf-8"?>
<!--
    P1-01: the empty app. One screen, a version number, nothing else.

    INTERNET arrives with P1-04, the network layer. It is the only permission
    here: no camera yet - that is asked for on the scan screen, where the need
    is obvious, never on first open - and no notifications yet.
-->
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Lets the app tell "no network" apart from "the server is down", so it
        can say which. Neither is a success, but they are different sentences.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        Where you are, so the Home map can show it. COARSE only: the card
        answers "which way to the gate", and a few hundred metres answers it.
        FINE would buy nothing and ask for more, and the walk itself is short
        enough that the difference never shows on a 112dp card.

        Asked for on the Home screen when the map first draws, not on first
        open, and the map works without it - it just has no blue dot.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!--
        Precise location, asked for and back on purpose - see ADR 0016.

        It was removed once, and the reasoning was right at the time: the map
        drew a fixed line and a blue dot, and for a dot on a 112dp card a
        coarse fix is an accuracy nobody can see.

        That stopped being true when the walk started being routed from where
        the person is standing. A coarse fix can be one to three kilometres
        out; the walk to the gate is 543 metres. Routing from it would draw a
        path beginning somewhere the person has never been - which is exactly
        the fault this permission is here to fix, not a smaller version of it.

        Both are requested together, so the system dialog offers Precise and
        Approximate side by side and the choice stays the user's. Approximate
        still gets the blue dot and the gate; it does not get a route.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!--
        The camera, to read the QR on the cabinet screen. P5-02.

        Asked for on the scan screen, at the moment a person taps "Scan to
        open" - never on first open. By then the need is obvious: they are
        standing at a locker holding a phone at a code.

        Refusing it is not a dead end. The typed code is the other way in
        (P5-08), and the scan screen offers it in the same breath as it
        explains why the camera is dark.
    -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!--
        The app reads a code off a screen an arm's length away. It does not
        need autofocus or a flash to do that, and a phone missing either must
        still be able to collect a parcel.
    -->
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartLocker"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false">

        <!--
            android:allowBackup="false" - the login token never leaves this
            phone. It is encrypted under a hardware key that cannot be backed
            up, so the copy would be unreadable anyway; not making the copy is
            simpler than relying on that. `adb backup` reads this flag too,
            which is the one an attacker with a cable would use. See
            @xml/data_extraction_rules for the Android 12 half.

            android:usesCleartextTraffic="false" - stated rather than assumed.
            It only defaults to false from API 28 and minSdk here is 24, so on
            an older phone a release build had no rule at all. Http.kt refuses
            a non-https URL before a socket opens; two locks, on purpose.
        -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SmartLocker"
            android:taskAffinity=""
            android:launchMode="singleTask">

            <!--
                An empty taskAffinity, and one task.

                Without it, another app can declare our affinity, and Android
                puts its activity at the front of OUR task - so the next time
                somebody opens the locker from their launcher, the attacker's
                screen is what appears, wearing our position in the recents
                list. It is called task hijacking, or StrandHogg, and the fix
                is this line: an empty affinity means no other app can claim
                to belong to our task.
            -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
