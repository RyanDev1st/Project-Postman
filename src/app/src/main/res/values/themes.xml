<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Compose draws every pixel of this app, so the Android theme only has
        to do two things: give the window no action bar, and set the colour
        that shows for the instant before Compose has drawn anything.
    -->
    <style name="Theme.SmartLocker" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>
